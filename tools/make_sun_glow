#!/usr/bin/env python3
"""Renders Media/SunGlow.tga: white with the shine in its alpha, a soft core
fading out with faint rays. Coloured and blended additively in the game."""
import math
import os
import struct

SIZE = 256
RAYS = 12
RAY_SHARE = 0.5   # how much of the shine lies in the rays, not the even glow

out = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Media", "SunGlow.tga")
pixels = bytearray()
for y in range(SIZE):
    for x in range(SIZE):
        dx, dy = (x + 0.5) / SIZE * 2 - 1, (y + 0.5) / SIZE * 2 - 1
        r = math.hypot(dx, dy)
        fade = max(0.0, 1 - r) ** 1.6
        ray = abs(math.cos(math.atan2(dy, dx) * RAYS / 2)) ** 3
        alpha = fade * ((1 - RAY_SHARE) + RAY_SHARE * ray)
        pixels += bytes((255, 255, 255, round(255 * alpha)))
with open(out, "wb") as f:
    f.write(struct.pack("<BBBHHBHHHHBB", 0, 0, 2, 0, 0, 0, 0, 0, SIZE, SIZE, 32, 8) + bytes(pixels))
