#!/usr/bin/env bash
# Build the release zip: one ForeverProgressBars folder with exactly what
# ./install copies, nothing else.
#   tools/package            -> dist/ForeverProgressBars-<version>.zip
set -eu
HERE="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="$(sed -n 's/^## Version: *//p' "$HERE/ForeverProgressBars.toc" | tr -d '\r')"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
"$HERE/install" "$STAGE" >/dev/null
mkdir -p "$HERE/dist"
OUT="$HERE/dist/ForeverProgressBars-$VERSION.zip"
rm -f "$OUT"
(cd "$STAGE" && zip -qrX "$OUT" ForeverProgressBars)
echo "$OUT"
